<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0F172A"
    android:gravity="center">

    <!-- Cyan Accent Line -->
    <View
        android:layout_width="80dp"
        android:layout_height="4dp"
        android:background="#00E5FF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Textbook"
        android:textSize="36sp"
        android:textColor="#F8FAFC"
        android:textStyle="bold"
        android:gravity="center"/>

    <!-- The Forum Branding -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Exchange Forum"
        android:textSize="36sp"
        android:textColor="#00E5FF"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect. Discuss. Trade."
        android:textSize="14sp"
        android:textColor="#94A3B8"
        android:gravity="center"
        android:layout_marginBottom="48dp"/>

    <!-- The Primary Action Button -->
    <Button
        android:id="@+id/btnAddBook"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Post New Listing"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:backgroundTint="#00E5FF"
        android:layout_marginBottom="20dp"
        app:cornerRadius="12dp"/>

    <!-- The Secondary Action Button -->
    <Button
        android:id="@+id/btnGoToSearch"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Browse Forum"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#F8FAFC"
        android:backgroundTint="#1E293B"
        app:cornerRadius="12dp"
        app:strokeColor="#00E5FF"
        app:strokeWidth="2dp"/>

</LinearLayout>