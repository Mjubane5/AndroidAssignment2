<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/background_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ResourceHub ✨"
        android:textSize="45sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connect. Discuss. Trade."
        android:textSize="18sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="50dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPostListing"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Post New Listing"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/accent_cyan"
        android:textColor="@color/background_dark"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBrowseForum"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Browse Forum"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:strokeColor="@color/accent_cyan"
        android:textColor="@color/accent_cyan"/>

</LinearLayout>